      </Parameter>
      <Parameter name="DetectionArcs" dataType="SensorArcs">
        <DefaultValue><Item><Field name="AzimuthStart">270</Field><Field name="AzimuthEnd">90</Field><Field name="ElevationMin">-90</Field><Field name="ElevationMax">15</Field></Item></DefaultValue>
      </Parameter>
      <Parameter name="Band" dataType="InfraredBandEnum"><DefaultValue>MidWave</DefaultValue></Parameter>
