<?xml version="1.0" encoding="UTF-8"?>
<!--
  XCGF archetype library split into files, assembled with XInclude: the XCGF standard library
  (library/: core types and standard equipment definitions) plus the example archetypes.
  Validate the whole library (references included):
    xmllint -xinclude -noout -schema ../../schemas/xcgf-data.xsd library.xml
  Each included file also validates on its own (structure and values).
-->
<XcgfData xmlns="urn:xcgf:data:1.0"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          version="1.0">
  <!-- Standard library -->
  <xi:include href="../../library/types/core.xml"/>
  <xi:include href="../../library/types/equipment.xml"/>
  <xi:include href="../../library/equipments/kinematics.xml"/>
  <xi:include href="../../library/equipments/signatures.xml"/>
  <xi:include href="../../library/equipments/sensors.xml"/>
  <!-- Example archetypes -->
  <xi:include href="equipments.xml"/>
  <xi:include href="tasks.xml"/>
  <Entities>
    <xi:include href="entities/Fighter.xml"/>
  </Entities>
  <xi:include href="units.xml"/>
</XcgfData>
