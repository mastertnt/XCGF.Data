<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example equipment library: concrete archetypes deriving from the XCGF standard definitions
  (library/equipments). Values are illustrative, not those of a real system.
-->
<EquipmentLibrary xmlns="urn:xcgf:data:1.0">

  <!-- Kinematics ========================================================= -->

  <KinematicDefinition name="FighterKinematic" base="FixedWingKinematic">
    <Description>Single-engine fighter with afterburner.</Description>
    <TechnologicalData>
      <Parameter name="EmptyMass" dataType="MassKilograms"><DefaultValue>8500</DefaultValue></Parameter>
      <Parameter name="MaxTakeoffMass" dataType="MassKilograms"><DefaultValue>19000</DefaultValue></Parameter>
      <Parameter name="DryThrust" dataType="ForceNewtons"><DefaultValue>75000</DefaultValue></Parameter>
      <Parameter name="AfterburnerThrust" dataType="ForceNewtons"><DefaultValue>125000</DefaultValue></Parameter>
      <Parameter name="FuelCapacity" dataType="MassKilograms"><DefaultValue>3200</DefaultValue></Parameter>
      <!-- Two altitude bands x four throttle settings (speed in m/s, consumption in kg/s). -->
      <Parameter name="PerformanceTable" dataType="PerformanceTable">
        <DefaultValue>
          <Item><Field name="MinAltitude">0</Field><Field name="MaxAltitude">2000</Field><Field name="Throttle">Loiter</Field><Field name="Speed">110</Field><Field name="FuelConsumption">0.25</Field></Item>
          <Item><Field name="MinAltitude">0</Field><Field name="MaxAltitude">2000</Field><Field name="Throttle">Cruise</Field><Field name="Speed">230</Field><Field name="FuelConsumption">0.45</Field></Item>
          <Item><Field name="MinAltitude">0</Field><Field name="MaxAltitude">2000</Field><Field name="Throttle">Full</Field><Field name="Speed">300</Field><Field name="FuelConsumption">1.0</Field></Item>
          <Item><Field name="MinAltitude">0</Field><Field name="MaxAltitude">2000</Field><Field name="Throttle">Flank</Field><Field name="Speed">400</Field><Field name="FuelConsumption">3.5</Field></Item>
          <Item><Field name="MinAltitude">2000</Field><Field name="MaxAltitude">12000</Field><Field name="Throttle">Loiter</Field><Field name="Speed">130</Field><Field name="FuelConsumption">0.18</Field></Item>
          <Item><Field name="MinAltitude">2000</Field><Field name="MaxAltitude">12000</Field><Field name="Throttle">Cruise</Field><Field name="Speed">250</Field><Field name="FuelConsumption">0.35</Field></Item>
          <Item><Field name="MinAltitude">2000</Field><Field name="MaxAltitude">12000</Field><Field name="Throttle">Full</Field><Field name="Speed">320</Field><Field name="FuelConsumption">0.8</Field></Item>
          <Item><Field name="MinAltitude">2000</Field><Field name="MaxAltitude">12000</Field><Field name="Throttle">Flank</Field><Field name="Speed">590</Field><Field name="FuelConsumption">2.8</Field></Item>
        </DefaultValue>
      </Parameter>
      <Parameter name="StallSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>60</DefaultValue></Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>590</DefaultValue></Parameter>
      <Parameter name="ClimbRate" dataType="SpeedMetersPerSecond"><DefaultValue>250</DefaultValue></Parameter>
      <Parameter name="Ceiling" dataType="DistanceMeters"><DefaultValue>15000</DefaultValue></Parameter>
      <Parameter name="Agility" dataType="Rating"><DefaultValue>4.5</DefaultValue></Parameter>
      <Parameter name="MinRunwayLength" dataType="DistanceMeters"><DefaultValue>450</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>200</DefaultValue></Parameter>
      <Parameter name="InitialFuel" dataType="MassKilograms"><DefaultValue>3200</DefaultValue></Parameter>
    </InitializationData>
  </KinematicDefinition>

  <!-- Signatures ========================================================= -->

  <EquipmentDefinition name="FighterSignature" base="AircraftSignature">
    <Description>Fighter signature: detection ranges in metres, radar cross sections in square metres.</Description>
    <TechnologicalData>
      <Parameter name="Dimensions" dataType="Dimensions">
        <DefaultValue><Field name="Length">15</Field><Field name="Span">10</Field><Field name="Height">5</Field></DefaultValue>
      </Parameter>
      <Parameter name="Visual" dataType="AspectDetectionRange">
        <DefaultValue><Field name="Front">11000</Field><Field name="Side">16000</Field><Field name="Rear">11000</Field><Field name="Top">20000</Field></DefaultValue>
      </Parameter>
      <Parameter name="Infrared" dataType="AspectDetectionRange">
        <DefaultValue><Field name="Front">20000</Field><Field name="Side">30000</Field><Field name="Rear">45000</Field><Field name="Top">30000</Field></DefaultValue>
      </Parameter>
      <Parameter name="RadarCrossSectionAToD" dataType="AspectRadarCrossSection">
        <DefaultValue><Field name="Front">3</Field><Field name="Side">8</Field><Field name="Rear">4</Field><Field name="Top">12</Field></DefaultValue>
      </Parameter>
      <Parameter name="RadarCrossSectionEToM" dataType="AspectRadarCrossSection">
        <DefaultValue><Field name="Front">1.2</Field><Field name="Side">5</Field><Field name="Rear">2</Field><Field name="Top">9</Field></DefaultValue>
      </Parameter>
    </TechnologicalData>
  </EquipmentDefinition>

  <!-- Sensors ============================================================ -->

  <EquipmentDefinition name="FighterRadar" base="Radar">
    <Description>Pulse-Doppler fire control radar, nose-mounted.</Description>
    <TechnologicalData>
      <Parameter name="Role" dataType="SensorRoleEnum"><DefaultValue>FireControl</DefaultValue></Parameter>
      <Parameter name="Generation" dataType="SensorGenerationEnum"><DefaultValue>Early2000s</DefaultValue></Parameter>
      <Parameter name="MinRange" dataType="DistanceMeters"><DefaultValue>200</DefaultValue></Parameter>
      <Parameter name="MaxRange" dataType="DistanceMeters"><DefaultValue>150000</DefaultValue></Parameter>
      <Parameter name="MinAltitude" dataType="DistanceMeters"><DefaultValue>0</DefaultValue></Parameter>
      <Parameter name="MaxAltitude" dataType="DistanceMeters"><DefaultValue>30000</DefaultValue></Parameter>
      <Parameter name="ScanInterval" dataType="DurationSeconds"><DefaultValue>2</DefaultValue></Parameter>
      <Parameter name="Capabilities" dataType="SensorCapabilities">
        <DefaultValue><Item>AirSearch</Item><Item>SurfaceSearch</Item><Item>RangeInformation</Item><Item>HeadingInformation</Item><Item>SpeedInformation</Item><Item>AltitudeInformation</Item><Item>TargetIllumination</Item></DefaultValue>
      </Parameter>
      <!-- Front sector of 120 degrees, from 300 to 60 through the nose. -->
      <Parameter name="DetectionArcs" dataType="SensorArcs">
        <DefaultValue><Item><Field name="AzimuthStart">300</Field><Field name="AzimuthEnd">60</Field><Field name="ElevationMin">-60</Field><Field name="ElevationMax">60</Field></Item></DefaultValue>
      </Parameter>
      <Parameter name="MaxContacts" dataType="Count"><DefaultValue>20</DefaultValue></Parameter>
      <Parameter name="FrequencyBands" dataType="NatoBands">
        <DefaultValue><Item>I</Item><Item>J</Item></DefaultValue>
      </Parameter>
      <Parameter name="PeakPower" dataType="PowerWatts"><DefaultValue>5000</DefaultValue></Parameter>
      <Parameter name="AntennaGain" dataType="Decibels"><DefaultValue>33</DefaultValue></Parameter>
      <Parameter name="HorizontalBeamwidth" dataType="AngleDegrees"><DefaultValue>3.2</DefaultValue></Parameter>
      <Parameter name="VerticalBeamwidth" dataType="AngleDegrees"><DefaultValue>4.5</DefaultValue></Parameter>
      <Parameter name="PulseWidth" dataType="ShortDurationSeconds"><DefaultValue>0.000001</DefaultValue></Parameter>
      <Parameter name="PulseRepetitionFrequency" dataType="FrequencyHertz"><DefaultValue>100000</DefaultValue></Parameter>
      <Parameter name="SystemNoiseLevel" dataType="Decibels"><DefaultValue>5</DefaultValue></Parameter>
      <Parameter name="ProcessingGain" dataType="Decibels"><DefaultValue>20</DefaultValue></Parameter>
      <Parameter name="RangeResolution" dataType="DistanceMeters"><DefaultValue>150</DefaultValue></Parameter>
      <Parameter name="AngularResolution" dataType="AngleDegrees"><DefaultValue>1.5</DefaultValue></Parameter>
      <Parameter name="Features" dataType="RadarFeatures">
        <DefaultValue><Item>PulseDoppler</Item><Item>LookDownShootDown</Item><Item>TrackWhileScan</Item></DefaultValue>
      </Parameter>
      <Parameter name="MaxIlluminatedTargets" dataType="Count"><DefaultValue>2</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="Mode" dataType="RadarModeEnum">
        <DefaultValue>Search</DefaultValue>
        <Constraints>
          <ListOfValues>
            <Value>Off</Value>
            <Value>Search</Value>
            <Value>Track</Value>
          </ListOfValues>
        </Constraints>
      </Parameter>
    </InitializationData>
  </EquipmentDefinition>

  <EquipmentDefinition name="RadarWarningReceiver" base="ESM">
    <Description>Radar warning receiver covering all around the aircraft.</Description>
    <TechnologicalData>
      <Parameter name="Role" dataType="SensorRoleEnum"><DefaultValue>RadarWarningReceiver</DefaultValue></Parameter>
      <Parameter name="Generation" dataType="SensorGenerationEnum"><DefaultValue>Late1990s</DefaultValue></Parameter>
      <Parameter name="MaxRange" dataType="DistanceMeters"><DefaultValue>350000</DefaultValue></Parameter>
      <Parameter name="Capabilities" dataType="SensorCapabilities">
        <DefaultValue><Item>AirSearch</Item><Item>SurfaceSearch</Item><Item>LandSearch</Item><Item>Classification</Item></DefaultValue>
      </Parameter>
      <Parameter name="FrequencyBands" dataType="NatoBands">
        <DefaultValue><Item>E</Item><Item>F</Item><Item>G</Item><Item>H</Item><Item>I</Item><Item>J</Item></DefaultValue>
      </Parameter>
      <Parameter name="Sensitivity" dataType="PowerDecibelMilliwatts"><DefaultValue>-60</DefaultValue></Parameter>
      <Parameter name="BearingAccuracy" dataType="AngleDegrees"><DefaultValue>10</DefaultValue></Parameter>
    </TechnologicalData>
  </EquipmentDefinition>

  <EquipmentDefinition name="FighterIRST" base="InfraredSensor">
    <Description>Infrared search and track, nose-mounted.</Description>
    <TechnologicalData>
      <Parameter name="Role" dataType="SensorRoleEnum"><DefaultValue>InfraredSearchAndTrack</DefaultValue></Parameter>
      <Parameter name="Generation" dataType="SensorGenerationEnum"><DefaultValue>Early2000s</DefaultValue></Parameter>
      <Parameter name="MaxRange" dataType="DistanceMeters"><DefaultValue>90000</DefaultValue></Parameter>
      <Parameter name="Capabilities" dataType="SensorCapabilities">
        <DefaultValue><Item>AirSearch</Item><Item>HeadingInformation</Item><Item>Classification</Item></DefaultValue>
      </Parameter>
      <Parameter name="DetectionArcs" dataType="SensorArcs">
        <DefaultValue><Item><Field name="AzimuthStart">270</Field><Field name="AzimuthEnd">90</Field><Field name="ElevationMin">-15</Field><Field name="ElevationMax">60</Field></Item></DefaultValue>
      </Parameter>
      <Parameter name="Band" dataType="InfraredBandEnum"><DefaultValue>DualBand</DefaultValue></Parameter>
      <Parameter name="Imaging" dataType="HLAboolean"><DefaultValue>HLAtrue</DefaultValue></Parameter>
    </TechnologicalData>
  </EquipmentDefinition>

  <!-- Weapons ============================================================ -->

  <EquipmentDefinition name="AirToAirMissile" type="Weapon">
    <Description>Air-to-air missile.</Description>
    <TechnologicalData>
      <Parameter name="MinRange" dataType="DistanceMeters"><DefaultValue>1000</DefaultValue></Parameter>
      <Parameter name="MaxRange" dataType="DistanceMeters"><DefaultValue>80000</DefaultValue></Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>1400</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="Armed" dataType="HLAboolean"><DefaultValue>HLAtrue</DefaultValue></Parameter>
    </InitializationData>
  </EquipmentDefinition>

</EquipmentLibrary>
