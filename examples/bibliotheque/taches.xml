<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bibliothèque de tâches, référencées par les équipements, les entités et les unités (TaskRef).
  WhoTaskee est obligatoire ; les autres catégories 5W et tous les paramètres sont optionnels,
  sauf required="true".
-->
<TaskLibrary xmlns="urn:xcgf:data:1.0">

  <TaskDefinition name="MoveTo">
    <Description>Rejoindre une position géographique, sans tenir compte de l'altitude.</Description>
    <WhoTaskee>
      <Parameter name="Executor" dataType="EntityReference"/>
    </WhoTaskee>
    <What>
      <Parameter name="Speed" dataType="SpeedMetersPerSecond">
        <DefaultValue>250</DefaultValue>
        <Constraints>
          <Min value="0" inclusive="false"/>
        </Constraints>
      </Parameter>
    </What>
    <Where>
      <!-- Point 2D : l'altitude est ignorée. -->
      <Parameter name="Destination" dataType="GeoPoint2D" required="true"/>
    </Where>
    <ActivationTrigger>
      <Immediate/>
    </ActivationTrigger>
    <ExitTriggers>
      <ExitTrigger outcome="Success">
        <OnPositionReached parameter="Destination" tolerance="500"/>
      </ExitTrigger>
      <ExitTrigger outcome="Failure">
        <AtTime delay="PT1H"/>
      </ExitTrigger>
    </ExitTriggers>
  </TaskDefinition>

  <TaskDefinition name="FireOnTarget">
    <Description>Tirer sur une cible.</Description>
    <WhoTasker>
      <Parameter name="Commander" dataType="EntityReference"/>
    </WhoTasker>
    <WhoTaskee>
      <Parameter name="Shooter" dataType="EntityReference"/>
    </WhoTaskee>
    <WhoAffected>
      <Parameter name="Target" dataType="EntityReference" required="true"/>
    </WhoAffected>
    <What>
      <!-- Moyen employé : un équipement de l'exécutant. -->
      <Parameter name="Weapon" dataType="EquipmentReference"/>
      <Parameter name="Salvo" dataType="Count">
        <DefaultValue>1</DefaultValue>
        <Constraints>
          <Min value="1"/>
          <Max value="2"/>
        </Constraints>
      </Parameter>
    </What>
    <ActivationTrigger>
      <OnCondition expression="InRange(Weapon, Target)"/>
    </ActivationTrigger>
    <ExitTriggers>
      <ExitTrigger outcome="Success">
        <OnEvent event="TargetDestroyed"/>
      </ExitTrigger>
      <ExitTrigger outcome="Failure">
        <OnEvent event="WeaponsExhausted"/>
      </ExitTrigger>
      <ExitTrigger outcome="Aborted">
        <OnEvent event="CeaseFire"/>
      </ExitTrigger>
    </ExitTriggers>
  </TaskDefinition>

  <TaskDefinition name="FollowFlightPlan">
    <Description>Suivre un plan de vol.</Description>
    <WhoTaskee>
      <Parameter name="Executor" dataType="EntityReference"/>
    </WhoTaskee>
    <What>
      <Parameter name="Loop" dataType="HLAboolean"><DefaultValue>HLAfalse</DefaultValue></Parameter>
    </What>
    <Where>
      <Parameter name="Plan" dataType="FlightPlan" required="true"/>
    </Where>
    <ActivationTrigger>
      <OnTaskEnd task="MoveTo" outcome="Success"/>
    </ActivationTrigger>
    <ExitTriggers>
      <ExitTrigger outcome="Success">
        <CustomTrigger kind="FlightPlanCompleted"/>
      </ExitTrigger>
      <ExitTrigger outcome="Aborted">
        <OnCondition expression="Fuel &lt; 0.1"/>
      </ExitTrigger>
    </ExitTriggers>
  </TaskDefinition>

  <TaskDefinition name="ChangeFormation">
    <Description>Faire changer de formation une unité.</Description>
    <WhoTaskee>
      <!-- Le chef de patrouille conduit le changement (Who ne contient que des entités). -->
      <Parameter name="Leader" dataType="EntityReference"/>
    </WhoTaskee>
    <What>
      <Parameter name="Formation" dataType="FormationEnum" required="true"/>
      <Parameter name="Spacing" dataType="DistanceMeters">
        <DefaultValue>1000</DefaultValue>
        <Constraints>
          <Min value="100"/>
        </Constraints>
      </Parameter>
    </What>
    <ActivationTrigger>
      <Immediate/>
    </ActivationTrigger>
    <ExitTriggers>
      <ExitTrigger outcome="Success">
        <CustomTrigger kind="FormationEstablished">
          <Argument name="tolerance" value="100"/>
        </CustomTrigger>
      </ExitTrigger>
      <ExitTrigger outcome="Failure">
        <AtTime delay="PT5M"/>
      </ExitTrigger>
    </ExitTriggers>
  </TaskDefinition>

</TaskLibrary>
