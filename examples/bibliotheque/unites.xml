<?xml version="1.0" encoding="UTF-8"?>
<!-- Archétypes d'unités : compositions d'archétypes d'entités et d'unités. -->
<Units xmlns="urn:xcgf:data:1.0">

  <Unit name="Patrouille_VBL" folder="Land">
    <Description>Patrouille de deux VBL.</Description>
    <EntityRef entity="VBL" role="Chef"/>
    <EntityRef entity="VBL" role="Equipier"/>
    <Tasks>
      <TaskRef task="Patrol"/>
    </Tasks>
  </Unit>

  <Unit name="Groupement_Reco" folder="Joint">
    <Description>Deux patrouilles VBL appuyées par un Tigre et un Rafale.</Description>
    <EntityRef entity="Tigre"/>
    <EntityRef entity="Rafale"/>
    <UnitRef unit="Patrouille_VBL" count="2"/>
    <Tasks>
      <TaskRef task="Reconnaissance"/>
    </Tasks>
  </Unit>

</Units>
