<?xml version="1.0" encoding="UTF-8"?>
<!-- Types de données, sur le modèle de l'OMT HLA 1516-2010. -->
<DataTypes xmlns="urn:xcgf:data:1.0">
  <BasicData name="HLAinteger32BE" size="32" interpretation="Entier signé" endian="Big" encoding="Complément à deux, 32 bits"/>
  <BasicData name="HLAfloat64BE" size="64" interpretation="Réel double précision" endian="Big" encoding="IEEE 754"/>
  <BasicData name="HLAoctet" size="8" interpretation="Octet" endian="Big" encoding="8 bits"/>

  <SimpleData name="FrequencyHz" representation="HLAfloat64BE" units="Hz" resolution="1" accuracy="1">
    <Semantics>Fréquence radio.</Semantics>
  </SimpleData>
  <SimpleData name="RangeMeters" representation="HLAfloat64BE" units="m" resolution="0.1" accuracy="1"/>
  <SimpleData name="DurationSeconds" representation="HLAfloat64BE" units="s" resolution="1" accuracy="1"/>
  <SimpleData name="SpeedMetersPerSecond" representation="HLAfloat64BE" units="m/s" resolution="0.01" accuracy="0.1"/>

  <EnumeratedData name="RadarModeEnum" representation="HLAinteger32BE">
    <Enumerator name="Off" value="0"/>
    <Enumerator name="Search" value="1"/>
    <Enumerator name="Track" value="2"/>
  </EnumeratedData>

  <ArrayData name="HLAASCIIstring" dataType="HLAoctet" cardinality="Dynamic" encoding="HLAvariableArray"/>
  <ArrayData name="FrequencyList" dataType="FrequencyHz" cardinality="Dynamic" encoding="HLAvariableArray"/>

  <SimpleData name="AngleDegrees" representation="HLAfloat64BE" units="deg" resolution="0.01" accuracy="0.01"/>

  <FixedRecordData name="GeoPosition">
    <Semantics>Position géodésique WGS84.</Semantics>
    <Field name="Latitude" dataType="AngleDegrees"/>
    <Field name="Longitude" dataType="AngleDegrees"/>
    <Field name="Altitude" dataType="RangeMeters"/>
  </FixedRecordData>

  <FixedRecordData name="Orientation">
    <Semantics>Cap [0, 360[, tangage [-90, 90], roulis [-180, 180], en degrés.</Semantics>
    <Field name="Heading" dataType="AngleDegrees"/>
    <Field name="Pitch" dataType="AngleDegrees"/>
    <Field name="Roll" dataType="AngleDegrees"/>
  </FixedRecordData>

  <ArrayData name="WaypointList" dataType="GeoPosition" cardinality="1..64" encoding="HLAvariableArray"/>

  <VariantRecordData name="RadarSettings" discriminant="Mode" dataType="RadarModeEnum">
    <Alternative enumerator="Search" name="SearchRange" dataType="RangeMeters"/>
    <Alternative enumerator="Track" name="TrackId" dataType="HLAinteger32BE"/>
  </VariantRecordData>

  <!-- Références à des instances (extension XCGF) : l'archétype déclare la donnée, l'instance visée est choisie au scénario. -->
  <ReferenceData name="UnitReference" target="Unit"/>
  <ReferenceData name="EntityReference" target="Entity"/>
  <ReferenceData name="EquipmentReference" target="Equipment"/>
</DataTypes>
