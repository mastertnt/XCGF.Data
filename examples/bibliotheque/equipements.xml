<?xml version="1.0" encoding="UTF-8"?>
<!-- Bibliothèque d'équipements : définitions réutilisées par les entités. -->
<EquipmentLibrary xmlns="urn:xcgf:data:1.0">

  <!-- Cinématiques ======================================================= -->

  <!-- Cinématique racine : toute cinématique en dérive et hérite de Position et Orientation. -->
  <KinematicDefinition name="Kinematic">
    <Description>Cinématique de base : position et orientation.</Description>
    <InitializationData>
      <Parameter name="Position" dataType="GeoPosition"/>
      <Parameter name="Orientation" dataType="Orientation"/>
    </InitializationData>
  </KinematicDefinition>

  <KinematicDefinition name="GroundKinematic" base="Kinematic">
    <TechnologicalData>
      <Parameter name="MinSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>-5</DefaultValue></Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>27.7</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <!-- Vitesse initiale : Min sur MinSpeed, Max sur MaxSpeed. -->
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond">
        <DefaultValue>0</DefaultValue>
        <Constraints>
          <Min ref="MinSpeed"/>
          <Max ref="MaxSpeed"/>
          <!-- Contrainte libre, interprétée par l'outil. -->
          <CustomConstraint kind="Step">
            <Argument name="step" value="0.5"/>
          </CustomConstraint>
        </Constraints>
      </Parameter>
    </InitializationData>
  </KinematicDefinition>

  <KinematicDefinition name="FixedWingKinematic" base="Kinematic">
    <TechnologicalData>
      <Parameter name="StallSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>60</DefaultValue></Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>600</DefaultValue></Parameter>
      <Parameter name="Ceiling" dataType="RangeMeters"><DefaultValue>15000</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond">
        <DefaultValue>200</DefaultValue>
        <Constraints>
          <Min ref="StallSpeed"/>
          <Max ref="MaxSpeed"/>
        </Constraints>
      </Parameter>
    </InitializationData>
  </KinematicDefinition>

  <KinematicDefinition name="RotaryWingKinematic" base="Kinematic">
    <TechnologicalData>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>80</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond">
        <DefaultValue>0</DefaultValue>
        <Constraints>
          <Min value="0"/>
          <Max ref="MaxSpeed"/>
        </Constraints>
      </Parameter>
    </InitializationData>
  </KinematicDefinition>

  <!-- Autres équipements ================================================= -->

  <EquipmentDefinition name="PR4G" type="Radio">
    <Description>Poste radio VHF.</Description>
    <TechnologicalData>
      <Parameter name="MinFrequency" dataType="FrequencyHz"><DefaultValue>30000000</DefaultValue></Parameter>
      <Parameter name="MaxFrequency" dataType="FrequencyHz"><DefaultValue>87975000</DefaultValue></Parameter>
      <Parameter name="MaxRange" dataType="RangeMeters">
        <DefaultValue>8000</DefaultValue>
        <Constraints>
          <Min value="0" inclusive="false"/>
        </Constraints>
      </Parameter>
    </TechnologicalData>
    <InitializationData>
      <!-- Fréquence active bornée par les données technologiques. -->
      <Parameter name="ActiveFrequency" dataType="FrequencyHz">
        <DefaultValue>30000000</DefaultValue>
        <Constraints>
          <Min ref="MinFrequency"/>
          <Max ref="MaxFrequency"/>
        </Constraints>
      </Parameter>
      <Parameter name="Callsign" dataType="HLAASCIIstring">
        <Constraints>
          <Pattern value="[A-Z]{2}[0-9]{2}"/>
        </Constraints>
      </Parameter>
    </InitializationData>
    <Tasks>
      <TaskRef task="Transmit"/>
    </Tasks>
  </EquipmentDefinition>

  <!-- Dérivée de PR4G : hérite de tout et surcharge la portée. -->
  <EquipmentDefinition name="PR4G_Vehicule" base="PR4G">
    <TechnologicalData>
      <Parameter name="MaxRange" dataType="RangeMeters"><DefaultValue>12000</DefaultValue></Parameter>
    </TechnologicalData>
  </EquipmentDefinition>

  <EquipmentDefinition name="RDR_Tigre" type="Radar">
    <TechnologicalData>
      <Parameter name="MaxRange" dataType="RangeMeters">
        <DefaultValue>20000</DefaultValue>
        <Constraints>
          <ListOfValues>
            <Value>10000</Value>
            <Value>20000</Value>
            <Value>40000</Value>
          </ListOfValues>
        </Constraints>
      </Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="Mode" dataType="RadarModeEnum"><DefaultValue>Search</DefaultValue></Parameter>
      <Parameter name="Settings" dataType="RadarSettings">
        <DefaultValue>Search:8000</DefaultValue>
        <Constraints>
          <Max ref="MaxRange"/>
        </Constraints>
      </Parameter>
    </InitializationData>
    <Tasks>
      <TaskRef task="Detect"/>
    </Tasks>
  </EquipmentDefinition>

</EquipmentLibrary>
