<?xml version="1.0" encoding="UTF-8"?>
<!-- Bibliothèque d'équipements : définitions réutilisées par les archétypes d'entités. -->
<EquipmentLibrary xmlns="urn:xcgf:data:1.0">

  <!-- Cinématiques ======================================================= -->

  <!-- Cinématique racine : toute cinématique en dérive et hérite de Position et Orientation. -->
  <KinematicDefinition name="Kinematic">
    <Description>Cinématique de base : position et orientation.</Description>
    <InitializationData>
      <Parameter name="Position" dataType="GeoPosition"/>
      <Parameter name="Orientation" dataType="Orientation"/>
    </InitializationData>
  </KinematicDefinition>

  <KinematicDefinition name="FixedWingKinematic" base="Kinematic">
    <Description>Cinématique d'aéronef à voilure fixe.</Description>
    <TechnologicalData>
      <Parameter name="StallSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>60</DefaultValue></Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>600</DefaultValue></Parameter>
      <Parameter name="Ceiling" dataType="DistanceMeters"><DefaultValue>15000</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <!-- Vitesse initiale bornée par deux données technologiques. -->
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond">
        <DefaultValue>200</DefaultValue>
        <Constraints>
          <Min ref="StallSpeed"/>
          <Max ref="MaxSpeed"/>
        </Constraints>
      </Parameter>
    </InitializationData>
  </KinematicDefinition>

  <!-- Capteurs et armements ============================================== -->

  <EquipmentDefinition name="FighterRadar" type="Radar">
    <Description>Radar de conduite de tir.</Description>
    <TechnologicalData>
      <Parameter name="MaxRange" dataType="DistanceMeters">
        <DefaultValue>150000</DefaultValue>
        <Constraints>
          <Min value="0" inclusive="false"/>
        </Constraints>
      </Parameter>
      <Parameter name="FieldOfView" dataType="AngleDegrees">
        <DefaultValue>120</DefaultValue>
        <Constraints>
          <Min value="0" inclusive="false"/>
          <Max value="360"/>
        </Constraints>
      </Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="Mode" dataType="RadarModeEnum">
        <DefaultValue>Search</DefaultValue>
        <Constraints>
          <ListOfValues>
            <Value>Off</Value>
            <Value>Search</Value>
            <Value>Track</Value>
          </ListOfValues>
        </Constraints>
      </Parameter>
    </InitializationData>
  </EquipmentDefinition>

  <EquipmentDefinition name="AirToAirMissile" type="Weapon">
    <Description>Missile air-air.</Description>
    <TechnologicalData>
      <Parameter name="MinRange" dataType="DistanceMeters"><DefaultValue>1000</DefaultValue></Parameter>
      <Parameter name="MaxRange" dataType="DistanceMeters"><DefaultValue>80000</DefaultValue></Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>1400</DefaultValue></Parameter>
    </TechnologicalData>
    <InitializationData>
      <Parameter name="Armed" dataType="HLAboolean"><DefaultValue>HLAtrue</DefaultValue></Parameter>
    </InitializationData>
  </EquipmentDefinition>

</EquipmentLibrary>
