<?xml version="1.0" encoding="UTF-8"?>
<!-- Archétype d'aéronef de type chasseur. 1.2.71.1.0.0.0 : plateforme aérienne, France, chasseur (codes illustratifs). -->
<Entity xmlns="urn:xcgf:data:1.0" name="Fighter" disType="1.2.71.1.0.0.0" environment="Air" folder="Aircraft/Fighter">
  <Description>Chasseur armé d'un radar et de deux missiles air-air.</Description>
  <!-- Hérite de Position et Orientation (cinématique racine) ; surcharge la vitesse initiale par défaut. -->
  <Kinematic definition="FixedWingKinematic">
    <InitializationData>
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>250</DefaultValue></Parameter>
    </InitializationData>
  </Kinematic>
  <Equipments>
    <Equipment name="Radar" definition="FighterRadar"/>
    <Equipment name="Missile_1" definition="AirToAirMissile"/>
    <Equipment name="Missile_2" definition="AirToAirMissile"/>
  </Equipments>
  <Tasks>
    <TaskRef task="MoveTo"/>
    <TaskRef task="FireOnTarget"/>
    <TaskRef task="FollowFlightPlan"/>
  </Tasks>
</Entity>
