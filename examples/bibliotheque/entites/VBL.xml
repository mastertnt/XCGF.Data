<?xml version="1.0" encoding="UTF-8"?>
<!-- Archétype de véhicule blindé léger. 1.1.71.2.1.0.0 : plateforme terrestre, France (codes illustratifs). -->
<Entity xmlns="urn:xcgf:data:1.0" name="VBL" disType="1.1.71.2.1.0.0" environment="Land" folder="Platforms/Armored">
  <Description>Véhicule blindé léger.</Description>
  <!-- Hérite de Position et Orientation (cinématique racine) ; surcharge la vitesse initiale par défaut. -->
  <Kinematic definition="GroundKinematic">
    <InitializationData>
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond"><DefaultValue>10</DefaultValue></Parameter>
    </InitializationData>
  </Kinematic>
  <Equipments>
    <!-- S'appuie sur la définition PR4G_Vehicule et en surcharge les valeurs par défaut. -->
    <Equipment name="Radio" definition="PR4G_Vehicule">
      <InitializationData>
        <Parameter name="ActiveFrequency" dataType="FrequencyHz"><DefaultValue>30025000</DefaultValue></Parameter>
      </InitializationData>
    </Equipment>
  </Equipments>
  <Tasks>
    <!-- MoveTo avec une vitesse par défaut propre à cet archétype. -->
    <TaskRef task="MoveTo">
      <Parameter name="Speed" dataType="SpeedMetersPerSecond"><DefaultValue>15</DefaultValue></Parameter>
    </TaskRef>
  </Tasks>
</Entity>
