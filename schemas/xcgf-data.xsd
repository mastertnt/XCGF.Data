<?xml version="1.0" encoding="UTF-8"?>
<!--
  XCGF.Data : schéma de description des données XCGF.

  Le document décrit :
    - des types de données, sur le modèle de l'OMT HLA (IEEE 1516-2010) ;
    - une bibliothèque d'équipements (définitions réutilisables) ;
    - des entités (type DIS, nom unique), conteneurs d'équipements, avec un équipement cinématique
      obligatoire qui porte position et orientation ; les définitions peuvent dériver les unes des autres.
      Un équipement d'entité n'existe qu'à l'intérieur de celle-ci ; il peut s'appuyer
      sur une définition de la bibliothèque ;
    - des unités, groupes d'entités (et éventuellement de sous-unités) ;
    - une bibliothèque de tâches (paramètres 5W optionnels, trigger d'activation, triggers de
      sortie), référencées par les équipements, les entités et les unités.

  Découpage en fichiers : DataTypes, EquipmentLibrary, TaskLibrary, Entities, Entity et Units sont des
  éléments globaux, donc chacun peut être la racine d'un fichier validable seul. Un document
  XcgfData les assemble par XInclude (xi:include) ; toutes les contraintes de référence
  (types, définitions d'équipements, entités) sont vérifiées sur le document assemblé :
    xmllint -xinclude -noout -schema schemas/xcgf-data.xsd examples/bibliotheque/bibliotheque.xml

  Extensibilité des contraintes : toute contrainte est un élément du groupe de substitution
  x:Constraint. Un schéma tiers peut en ajouter en dérivant x:ConstraintType ; CustomConstraint
  couvre les besoins ponctuels sans nouveau schéma. Les triggers suivent le même principe (x:Trigger).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:x="urn:xcgf:data:1.0"
           targetNamespace="urn:xcgf:data:1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <!-- ================================================================== -->
  <!-- Racine                                                             -->
  <!-- ================================================================== -->

  <xs:element name="XcgfData">
    <xs:annotation>
      <xs:documentation>Racine d'un document XCGF. Les sections peuvent apparaître plusieurs fois et
        dans un ordre quelconque, ce qui permet d'assembler une bibliothèque découpée en fichiers.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="x:DataTypes"/>
        <xs:element ref="x:EquipmentLibrary"/>
        <xs:element ref="x:TaskLibrary"/>
        <xs:element ref="x:Entities"/>
        <xs:element ref="x:Units"/>
      </xs:choice>
      <xs:attribute name="version" type="xs:string" use="optional"/>
    </xs:complexType>

    <!-- Noms de types de données : uniques toutes catégories confondues. -->
    <xs:key name="DataTypeKey">
      <xs:selector xpath="x:DataTypes/x:BasicData|x:DataTypes/x:SimpleData|x:DataTypes/x:EnumeratedData|x:DataTypes/x:ArrayData|x:DataTypes/x:FixedRecordData|x:DataTypes/x:VariantRecordData|x:DataTypes/x:ReferenceData"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Représentations de base (cibles de @representation). -->
    <xs:key name="BasicDataKey">
      <xs:selector xpath="x:DataTypes/x:BasicData"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Types énumérés (cibles du discriminant d'un enregistrement variant). -->
    <xs:key name="EnumeratedDataKey">
      <xs:selector xpath="x:DataTypes/x:EnumeratedData"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Toute référence @dataType doit désigner un type déclaré. -->
    <xs:keyref name="DataTypeRef" refer="x:DataTypeKey">
      <xs:selector xpath="x:DataTypes/x:ArrayData|.//x:Field|.//x:Alternative|.//x:Parameter"/>
      <xs:field xpath="@dataType"/>
    </xs:keyref>

    <xs:keyref name="RepresentationRef" refer="x:BasicDataKey">
      <xs:selector xpath="x:DataTypes/x:SimpleData|x:DataTypes/x:EnumeratedData"/>
      <xs:field xpath="@representation"/>
    </xs:keyref>

    <xs:keyref name="DiscriminantTypeRef" refer="x:EnumeratedDataKey">
      <xs:selector xpath="x:DataTypes/x:VariantRecordData"/>
      <xs:field xpath="@dataType"/>
    </xs:keyref>

    <!-- Nom de définition d'équipement unique dans la bibliothèque. -->
    <xs:unique name="EquipmentLibraryNameUnique">
      <xs:selector xpath="x:EquipmentLibrary/x:EquipmentDefinition|x:EquipmentLibrary/x:KinematicDefinition"/>
      <xs:field xpath="@name"/>
    </xs:unique>

    <xs:key name="EquipmentDefinitionKey">
      <xs:selector xpath="x:EquipmentLibrary/x:EquipmentDefinition"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <xs:key name="KinematicDefinitionKey">
      <xs:selector xpath="x:EquipmentLibrary/x:KinematicDefinition"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Une définition ne dérive que d'une définition de même nature. -->
    <xs:keyref name="EquipmentDefinitionBaseRef" refer="x:EquipmentDefinitionKey">
      <xs:selector xpath="x:EquipmentLibrary/x:EquipmentDefinition"/>
      <xs:field xpath="@base"/>
    </xs:keyref>

    <xs:keyref name="KinematicDefinitionBaseRef" refer="x:KinematicDefinitionKey">
      <xs:selector xpath="x:EquipmentLibrary/x:KinematicDefinition"/>
      <xs:field xpath="@base"/>
    </xs:keyref>

    <!-- La cinématique d'une entité s'appuie sur une définition cinématique. -->
    <xs:keyref name="KinematicDefinitionRef" refer="x:KinematicDefinitionKey">
      <xs:selector xpath="x:Entities/x:Entity/x:Kinematic"/>
      <xs:field xpath="@definition"/>
    </xs:keyref>

    <!-- Un équipement d'entité ne peut s'appuyer que sur une définition existante. -->
    <xs:keyref name="EquipmentDefinitionRef" refer="x:EquipmentDefinitionKey">
      <xs:selector xpath="x:Entities/x:Entity/x:Equipments/x:Equipment"/>
      <xs:field xpath="@definition"/>
    </xs:keyref>

    <!-- Nom d'entité unique parmi l'ensemble des entités du document. -->
    <xs:key name="EntityNameKey">
      <xs:selector xpath="x:Entities/x:Entity"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Nom d'unité unique parmi toutes les unités, sous-unités comprises. -->
    <xs:key name="UnitNameKey">
      <xs:selector xpath=".//x:Unit"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Nom de définition de tâche unique dans la bibliothèque. -->
    <xs:key name="TaskDefinitionKey">
      <xs:selector xpath="x:TaskLibrary/x:TaskDefinition"/>
      <xs:field xpath="@name"/>
    </xs:key>

    <!-- Équipements, entités et unités ne référencent que des tâches définies. -->
    <xs:keyref name="TaskRef" refer="x:TaskDefinitionKey">
      <xs:selector xpath=".//x:TaskRef"/>
      <xs:field xpath="@task"/>
    </xs:keyref>

    <!-- Une valeur Ref désigne une entité et une unité existantes. -->
    <xs:keyref name="InstanceRefEntity" refer="x:EntityNameKey">
      <xs:selector xpath=".//x:Ref"/>
      <xs:field xpath="@entity"/>
    </xs:keyref>

    <xs:keyref name="InstanceRefUnit" refer="x:UnitNameKey">
      <xs:selector xpath=".//x:Ref"/>
      <xs:field xpath="@unit"/>
    </xs:keyref>

    <!-- Une unité ne peut référencer qu'une entité existante. -->
    <xs:keyref name="UnitEntityRef" refer="x:EntityNameKey">
      <xs:selector xpath=".//x:EntityRef"/>
      <xs:field xpath="@entity"/>
    </xs:keyref>
  </xs:element>

  <!-- ================================================================== -->
  <!-- Types simples communs                                              -->
  <!-- ================================================================== -->

  <xs:simpleType name="IdentifierType">
    <xs:annotation>
      <xs:documentation>Identifiant : lettre ou '_' puis lettres, chiffres, '_', '-' ou '.'.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EndianType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Big"/>
      <xs:enumeration value="Little"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CardinalityType">
    <xs:annotation>
      <xs:documentation>Cardinalité HLA : entier, plage "min..max" ou "Dynamic".</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="Dynamic|[0-9]+|[0-9]+\.\.[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ================================================================== -->
  <!-- Types de données (OMT HLA 1516-2010)                               -->
  <!-- ================================================================== -->

  <!-- Attributs xml:* (notamment xml:base, ajouté par XInclude) sur les racines de fichier. -->
  <xs:attributeGroup name="FileRootAttributes">
    <xs:anyAttribute namespace="http://www.w3.org/XML/1998/namespace" processContents="skip"/>
  </xs:attributeGroup>

  <xs:element name="DataTypes" type="x:DataTypesType"/>

  <xs:complexType name="DataTypesType">
    <xs:annotation>
      <xs:documentation>Déclarations de types, dans un ordre quelconque.</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="BasicData" type="x:BasicDataType"/>
      <xs:element name="SimpleData" type="x:SimpleDataType"/>
      <xs:element name="EnumeratedData" type="x:EnumeratedDataType"/>
      <xs:element name="ArrayData" type="x:ArrayDataType"/>
      <xs:element name="FixedRecordData" type="x:FixedRecordDataType"/>
      <xs:element name="VariantRecordData" type="x:VariantRecordDataType"/>
      <xs:element name="ReferenceData" type="x:ReferenceDataType"/>
    </xs:choice>
    <xs:attributeGroup ref="x:FileRootAttributes"/>
  </xs:complexType>

  <xs:complexType name="DataTypeBase" abstract="true">
    <xs:sequence>
      <xs:element name="Semantics" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <xs:complexType name="BasicDataType">
    <xs:annotation>
      <xs:documentation>Représentation binaire de base (ex. HLAinteger32BE, HLAfloat64LE).</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:attribute name="size" type="xs:positiveInteger" use="required">
          <xs:annotation><xs:documentation>Taille en bits.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="interpretation" type="xs:string" use="optional"/>
        <xs:attribute name="endian" type="x:EndianType" use="required"/>
        <xs:attribute name="encoding" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SimpleDataType">
    <xs:annotation>
      <xs:documentation>Type scalaire défini sur une représentation de base, avec unité et précision.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:attribute name="representation" type="x:IdentifierType" use="required"/>
        <xs:attribute name="units" type="xs:string" use="optional"/>
        <xs:attribute name="resolution" type="xs:string" use="optional"/>
        <xs:attribute name="accuracy" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="EnumeratedDataType">
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:sequence>
          <xs:element name="Enumerator" maxOccurs="unbounded">
            <xs:complexType>
              <xs:attribute name="name" type="x:IdentifierType" use="required"/>
              <xs:attribute name="value" type="xs:long" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="representation" type="x:IdentifierType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ArrayDataType">
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:attribute name="dataType" type="x:IdentifierType" use="required">
          <xs:annotation><xs:documentation>Type des éléments.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="cardinality" type="x:CardinalityType" use="required"/>
        <xs:attribute name="encoding" type="xs:string" use="required">
          <xs:annotation><xs:documentation>Ex. HLAfixedArray, HLAvariableArray.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FieldType">
    <xs:sequence>
      <xs:element name="Semantics" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
    <xs:attribute name="dataType" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <xs:complexType name="FixedRecordDataType">
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:sequence>
          <xs:element name="Field" type="x:FieldType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="encoding" type="xs:string" use="optional" default="HLAfixedRecord"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="VariantRecordDataType">
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:sequence>
          <xs:element name="Alternative" maxOccurs="unbounded">
            <xs:complexType>
              <xs:complexContent>
                <xs:extension base="x:FieldType">
                  <xs:attribute name="enumerator" type="xs:string" use="required">
                    <xs:annotation><xs:documentation>Valeur(s) du discriminant sélectionnant cette alternative (liste séparée par des virgules, ou HLAother).</xs:documentation></xs:annotation>
                  </xs:attribute>
                </xs:extension>
              </xs:complexContent>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="discriminant" type="x:IdentifierType" use="required"/>
        <xs:attribute name="dataType" type="x:IdentifierType" use="required">
          <xs:annotation><xs:documentation>Type énuméré du discriminant.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="encoding" type="xs:string" use="optional" default="HLAvariantRecord"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="ReferenceTargetType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Unit"/>
      <xs:enumeration value="Entity"/>
      <xs:enumeration value="Equipment"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ReferenceDataType">
    <xs:annotation>
      <xs:documentation>Extension XCGF (hors OMT HLA) : référence à une instance d'unité, d'entité (plateforme)
        ou d'équipement, jamais à un type ou à une définition. La valeur d'une donnée de ce type est un Ref.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="x:DataTypeBase">
        <xs:attribute name="target" type="x:ReferenceTargetType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Paramètres et tâches                                               -->
  <!-- ================================================================== -->

  <xs:complexType name="ParameterType">
    <xs:annotation>
      <xs:documentation>Valeur nommée, typée par un type de données déclaré. La valeur est portée en texte.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="x:IdentifierType" use="required"/>
        <xs:attribute name="dataType" type="x:IdentifierType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ParametersType">
    <xs:sequence>
      <xs:element name="Parameter" type="x:ParameterType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Contraintes : groupe de substitution extensible -->

  <xs:complexType name="ArgumentType">
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ConstraintType" abstract="true">
    <xs:annotation>
      <xs:documentation>Base de toute contrainte. Pour ajouter une contrainte, dériver ce type et déclarer
        un élément avec substitutionGroup="x:Constraint" (dans ce schéma ou un schéma tiers).</xs:documentation>
    </xs:annotation>
  </xs:complexType>

  <xs:element name="Constraint" type="x:ConstraintType" abstract="true"/>

  <xs:complexType name="BoundConstraintType">
    <xs:complexContent>
      <xs:extension base="x:ConstraintType">
        <xs:attribute name="value" type="xs:string" use="optional">
          <xs:annotation><xs:documentation>Borne littérale.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ref" type="x:IdentifierType" use="optional">
          <xs:annotation><xs:documentation>Borne donnée par une donnée technologique du même équipement (ex. MaxSpeed).
            Exactement un de value ou ref doit être renseigné.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="inclusive" type="xs:boolean" use="optional" default="true"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="Min" type="x:BoundConstraintType" substitutionGroup="x:Constraint">
    <xs:annotation><xs:documentation>Borne inférieure (incluse par défaut).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:element name="Max" type="x:BoundConstraintType" substitutionGroup="x:Constraint">
    <xs:annotation><xs:documentation>Borne supérieure (incluse par défaut).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="ListOfValuesConstraintType">
    <xs:complexContent>
      <xs:extension base="x:ConstraintType">
        <xs:sequence>
          <xs:element name="Value" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="ListOfValues" type="x:ListOfValuesConstraintType" substitutionGroup="x:Constraint">
    <xs:annotation><xs:documentation>Liste fermée des valeurs autorisées.</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="PatternConstraintType">
    <xs:complexContent>
      <xs:extension base="x:ConstraintType">
        <xs:attribute name="value" type="xs:string" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="Pattern" type="x:PatternConstraintType" substitutionGroup="x:Constraint">
    <xs:annotation><xs:documentation>Expression régulière que la valeur textuelle doit respecter.</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="CustomConstraintType">
    <xs:complexContent>
      <xs:extension base="x:ConstraintType">
        <xs:sequence>
          <xs:element name="Argument" type="x:ArgumentType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="kind" type="x:IdentifierType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="CustomConstraint" type="x:CustomConstraintType" substitutionGroup="x:Constraint">
    <xs:annotation><xs:documentation>Contrainte libre, identifiée par kind et interprétée par l'outil (ex. Step).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="ConstraintsType">
    <xs:annotation>
      <xs:documentation>Contraintes cumulables sur la valeur d'une donnée d'équipement.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="x:Constraint" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DataItemType">
    <xs:annotation>
      <xs:documentation>Donnée d'équipement (technologique ou d'initialisation) : valeur typée, éventuellement contrainte.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice minOccurs="0">
        <xs:element name="Value" type="xs:string"/>
        <xs:element name="Ref" type="x:InstanceRefType">
          <xs:annotation><xs:documentation>Valeur d'une donnée de type ReferenceData.</xs:documentation></xs:annotation>
        </xs:element>
      </xs:choice>
      <xs:element name="Constraints" type="x:ConstraintsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
    <xs:attribute name="dataType" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <xs:complexType name="InstanceRefType">
    <xs:annotation>
      <xs:documentation>Référence à une instance : unité (@unit), entité (@entity), ou équipement (@equipment,
        de l'entité @entity, ou du porteur si @entity est absent). Les noms d'unités et d'entités
        sont vérifiés par le schéma ; l'existence de l'équipement et l'accord avec la cible du
        ReferenceData sont vérifiés par l'outil.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="unit" type="x:IdentifierType" use="optional"/>
    <xs:attribute name="entity" type="x:IdentifierType" use="optional"/>
    <xs:attribute name="equipment" type="x:IdentifierType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DataItemsType">
    <xs:sequence>
      <xs:element name="Parameter" type="x:DataItemType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Triggers : groupe de substitution extensible -->

  <xs:complexType name="TriggerType" abstract="true">
    <xs:annotation>
      <xs:documentation>Base de tout trigger. Pour en ajouter, dériver ce type et déclarer un élément
        avec substitutionGroup="x:Trigger" ; CustomTrigger couvre les besoins ponctuels.</xs:documentation>
    </xs:annotation>
  </xs:complexType>

  <xs:element name="Trigger" type="x:TriggerType" abstract="true"/>

  <xs:complexType name="ImmediateTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType"/>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="Immediate" type="x:ImmediateTriggerType" substitutionGroup="x:Trigger">
    <xs:annotation><xs:documentation>Déclenché dès que possible (activation du porteur, ou démarrage de la tâche pour une sortie).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="AtTimeTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType">
        <xs:attribute name="time" type="xs:dateTime" use="optional">
          <xs:annotation><xs:documentation>Instant absolu.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="delay" type="xs:duration" use="optional">
          <xs:annotation><xs:documentation>Délai relatif (début de scénario pour une activation, début de la tâche pour une sortie).
            Exactement un de time ou delay doit être renseigné.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="AtTime" type="x:AtTimeTriggerType" substitutionGroup="x:Trigger"/>

  <xs:complexType name="OnTaskEndTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType">
        <xs:attribute name="task" type="x:IdentifierType" use="required"/>
        <xs:attribute name="outcome" type="xs:string" use="optional">
          <xs:annotation><xs:documentation>Issue attendue de la tâche (ex. Success) ; toute issue si absent.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="OnTaskEnd" type="x:OnTaskEndTriggerType" substitutionGroup="x:Trigger">
    <xs:annotation><xs:documentation>Fin d'une autre tâche (enchaînement).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="OnPositionReachedTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType">
        <xs:attribute name="parameter" type="x:IdentifierType" use="optional">
          <xs:annotation><xs:documentation>Paramètre Where de la tâche donnant la position à atteindre (ex. Destination).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="tolerance" type="xs:double" use="optional" default="0">
          <xs:annotation><xs:documentation>Distance en mètres sous laquelle la position est considérée atteinte.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="OnPositionReached" type="x:OnPositionReachedTriggerType" substitutionGroup="x:Trigger"/>

  <xs:complexType name="OnEventTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType">
        <xs:attribute name="event" type="xs:string" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="OnEvent" type="x:OnEventTriggerType" substitutionGroup="x:Trigger">
    <xs:annotation><xs:documentation>Événement nommé (ex. EnemyDetected, OrderReceived).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="OnConditionTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType">
        <xs:attribute name="expression" type="xs:string" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="OnCondition" type="x:OnConditionTriggerType" substitutionGroup="x:Trigger">
    <xs:annotation><xs:documentation>Condition évaluée par l'outil (ex. Fuel &lt; 0.2).</xs:documentation></xs:annotation>
  </xs:element>

  <xs:complexType name="CustomTriggerType">
    <xs:complexContent>
      <xs:extension base="x:TriggerType">
        <xs:sequence>
          <xs:element name="Argument" type="x:ArgumentType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="kind" type="x:IdentifierType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="CustomTrigger" type="x:CustomTriggerType" substitutionGroup="x:Trigger"/>

  <xs:complexType name="ActivationTriggerType">
    <xs:sequence>
      <xs:element ref="x:Trigger"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ExitTriggerType">
    <xs:sequence>
      <xs:element ref="x:Trigger"/>
    </xs:sequence>
    <xs:attribute name="outcome" type="xs:string" use="optional" default="Success">
      <xs:annotation><xs:documentation>Issue de la tâche quand ce trigger la termine (ex. Success, Failure, Aborted).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Paramètres de tâche (5W) -->

  <xs:complexType name="TaskParameterType">
    <xs:annotation>
      <xs:documentation>Paramètre déclaré par une définition de tâche : type, valeur par défaut éventuelle, contraintes.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="x:DataItemType">
        <xs:attribute name="required" type="xs:boolean" use="optional" default="false"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="TaskParametersType">
    <xs:sequence>
      <xs:element name="Parameter" type="x:TaskParameterType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Définition de tâche -->

  <xs:complexType name="TaskDefinitionType">
    <xs:annotation>
      <xs:documentation>Définition de tâche (ex. MoveTo). Ses paramètres sont rangés selon les 5W
        (Who, What, When, Where, Why) ; chaque catégorie et chaque paramètre sont optionnels
        (required="false" par défaut). La tâche démarre sur son trigger d'activation et se termine
        sur le premier de ses triggers de sortie.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
      <xs:element name="Who" type="x:TaskParametersType" minOccurs="0">
        <xs:annotation><xs:documentation>Qui : acteurs, cibles.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="What" type="x:TaskParametersType" minOccurs="0">
        <xs:annotation><xs:documentation>Quoi : modalités de l'action (vitesse, formation…).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="When" type="x:TaskParametersType" minOccurs="0">
        <xs:annotation><xs:documentation>Quand : horaires, durée.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Where" type="x:TaskParametersType" minOccurs="0">
        <xs:annotation><xs:documentation>Où : position, itinéraire, zone.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Why" type="x:TaskParametersType" minOccurs="0">
        <xs:annotation><xs:documentation>Pourquoi : intention, effet recherché.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="ActivationTrigger" type="x:ActivationTriggerType"/>
      <xs:element name="ExitTriggers">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ExitTrigger" type="x:ExitTriggerType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <xs:element name="TaskLibrary">
    <xs:annotation>
      <xs:documentation>Bibliothèque de tâches ; peut constituer un fichier à elle seule.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaskDefinition" type="x:TaskDefinitionType" minOccurs="0" maxOccurs="unbounded">
          <!-- Nom de paramètre unique au sein d'une tâche, toutes catégories 5W confondues. -->
          <xs:unique name="TaskParameterNameUnique">
            <xs:selector xpath="x:Who/x:Parameter|x:What/x:Parameter|x:When/x:Parameter|x:Where/x:Parameter|x:Why/x:Parameter"/>
            <xs:field xpath="@name"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
      <xs:attributeGroup ref="x:FileRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Référence de tâche -->

  <xs:complexType name="TaskRefType">
    <xs:annotation>
      <xs:documentation>Tâche que peut réaliser son porteur (équipement, entité ou unité), par référence à une
        définition de la TaskLibrary. Les Parameter éventuels fixent des valeurs propres au porteur.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Parameter" type="x:DataItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="task" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <xs:complexType name="TasksType">
    <xs:sequence>
      <xs:element name="TaskRef" type="x:TaskRefType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Équipements                                                        -->
  <!-- ================================================================== -->

  <xs:group name="EquipmentContent">
    <xs:sequence>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
      <xs:element name="TechnologicalData" type="x:DataItemsType" minOccurs="0">
        <xs:annotation><xs:documentation>Données technologiques : caractéristiques de l'équipement (ex. portée, bande de fréquences).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="InitializationData" type="x:DataItemsType" minOccurs="0">
        <xs:annotation><xs:documentation>Données d'initialisation : état initial de l'équipement (ex. mode, fréquence active).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="Tasks" type="x:TasksType" minOccurs="0"/>
    </xs:sequence>
  </xs:group>

  <xs:complexType name="DefinitionBaseType" abstract="true">
    <xs:annotation>
      <xs:documentation>Base des définitions de la bibliothèque. Une définition peut dériver d'une autre (@base) :
        elle hérite de toutes ses données et tâches, en ajoute et peut surcharger leurs valeurs ou
        contraintes (fusion par nom, faite par l'outil, qui détecte aussi les cycles).</xs:documentation>
    </xs:annotation>
    <xs:group ref="x:EquipmentContent"/>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
    <xs:attribute name="base" type="x:IdentifierType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="EquipmentDefinitionType">
    <xs:annotation>
      <xs:documentation>Définition d'équipement de la bibliothèque, réutilisable par plusieurs entités.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="x:DefinitionBaseType">
        <xs:attribute name="type" type="xs:string" use="optional">
          <xs:annotation><xs:documentation>Nature de l'équipement (ex. Radar, Radio, Weapon) ; hérité de @base si absent.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="KinematicDefinitionType">
    <xs:annotation>
      <xs:documentation>Définition d'équipement cinématique. Toute cinématique fournit au minimum, en données
        d'initialisation, une position et une orientation (portées par l'élément Kinematic de l'entité).
        Les dérivées (ex. FixedWingKinematic, base="Kinematic") ajoutent des données technologiques
        et d'initialisation.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="x:DefinitionBaseType"/>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="EquipmentLibrary">
    <xs:annotation>
      <xs:documentation>Bibliothèque d'équipements ; peut constituer un fichier à elle seule.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="EquipmentDefinition" type="x:EquipmentDefinitionType"/>
        <xs:element name="KinematicDefinition" type="x:KinematicDefinitionType"/>
      </xs:choice>
      <xs:attributeGroup ref="x:FileRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="EquipmentType">
    <xs:annotation>
      <xs:documentation>Équipement d'une entité. Sans existence propre : il n'est déclaré qu'à l'intérieur d'une entité.
        S'il référence une définition (@definition), son contenu complète ou surcharge celui de la définition
        (fusion par nom de donnée, faite par l'outil) ; sinon il est entièrement décrit sur place et @type est attendu.</xs:documentation>
    </xs:annotation>
    <xs:group ref="x:EquipmentContent"/>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
    <xs:attribute name="definition" type="x:IdentifierType" use="optional"/>
    <xs:attribute name="type" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="KinematicInitializationDataType">
    <xs:annotation>
      <xs:documentation>Données d'initialisation d'une cinématique : position et orientation obligatoires,
        puis les données propres à la définition (ex. InitialSpeed).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Position" type="x:PositionType"/>
      <xs:element name="Orientation" type="x:OrientationType"/>
      <xs:element name="Parameter" type="x:DataItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="KinematicType">
    <xs:annotation>
      <xs:documentation>Équipement cinématique d'une entité (obligatoire, un seul). Il s'appuie sur une
        définition cinématique de la bibliothèque et porte au minimum position et orientation.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
      <xs:element name="TechnologicalData" type="x:DataItemsType" minOccurs="0"/>
      <xs:element name="InitializationData" type="x:KinematicInitializationDataType"/>
      <xs:element name="Tasks" type="x:TasksType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="definition" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Entités                                                            -->
  <!-- ================================================================== -->

  <xs:simpleType name="LatitudeType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-90"/>
      <xs:maxInclusive value="90"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LongitudeType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-180"/>
      <xs:maxInclusive value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PositionType">
    <xs:annotation>
      <xs:documentation>Position géodésique WGS84 : latitude et longitude en degrés décimaux, altitude en mètres.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="latitude" type="x:LatitudeType" use="required"/>
    <xs:attribute name="longitude" type="x:LongitudeType" use="required"/>
    <xs:attribute name="altitude" type="xs:double" use="required"/>
  </xs:complexType>

  <xs:simpleType name="HeadingType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
      <xs:maxExclusive value="360"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PitchType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-90"/>
      <xs:maxInclusive value="90"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RollType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-180"/>
      <xs:maxInclusive value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="OrientationType">
    <xs:annotation>
      <xs:documentation>Orientation en degrés : cap [0, 360[, tangage [-90, 90], roulis [-180, 180].</xs:documentation>
    </xs:annotation>
    <xs:attribute name="heading" type="x:HeadingType" use="required"/>
    <xs:attribute name="pitch" type="x:PitchType" use="required"/>
    <xs:attribute name="roll" type="x:RollType" use="required"/>
  </xs:complexType>

  <xs:simpleType name="DisEntityTypeType">
    <xs:annotation>
      <xs:documentation>Type d'entité DIS (IEEE 1278.1, Entity Type Record) en notation pointée
        Kind.Domain.Country.Category.Subcategory.Specific.Extra, par exemple 1.1.225.1.0.0.0.
        Country est sur 16 bits, les autres champs sur 8 bits. Même notation que XCGF.ArchetypeEditor.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}|0)\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EnvironmentType">
    <xs:annotation>
      <xs:documentation>Environnement d'évolution, aligné sur le domaine DIS (comme EntityEnvironment de XCGF.ArchetypeEditor).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Other"/>
      <xs:enumeration value="Land"/>
      <xs:enumeration value="Air"/>
      <xs:enumeration value="Surface"/>
      <xs:enumeration value="Subsurface"/>
      <xs:enumeration value="Space"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="EntityType">
    <xs:annotation>
      <xs:documentation>Entité : conteneur d'équipements, identifiée par un nom unique. Sa position et son
        orientation sont les données d'initialisation de son équipement cinématique, obligatoire.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
      <xs:element name="Kinematic" type="x:KinematicType"/>
      <xs:element name="Parameters" type="x:ParametersType" minOccurs="0"/>
      <xs:element name="Equipments" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Equipment" type="x:EquipmentType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Tasks" type="x:TasksType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
    <xs:attribute name="disType" type="x:DisEntityTypeType" use="required"/>
    <xs:attribute name="environment" type="x:EnvironmentType" use="optional"/>
    <xs:attribute name="folder" type="xs:string" use="optional">
      <xs:annotation><xs:documentation>Classement dans la bibliothèque, segments séparés par '/' (ex. Platforms/Armored).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="x:FileRootAttributes"/>
  </xs:complexType>

  <xs:element name="Entity" type="x:EntityType">
    <xs:annotation><xs:documentation>Entité ; peut constituer un fichier à elle seule.</xs:documentation></xs:annotation>
    <!-- Nom d'équipement unique au sein de son entité. -->
    <xs:unique name="EquipmentNameUnique">
      <xs:selector xpath="x:Equipments/x:Equipment"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>

  <xs:element name="Entities" type="x:EntitiesType"/>

  <xs:complexType name="EntitiesType">
    <xs:sequence>
      <xs:element ref="x:Entity" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="x:FileRootAttributes"/>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Unités                                                             -->
  <!-- ================================================================== -->

  <xs:complexType name="EntityRefType">
    <xs:attribute name="entity" type="x:IdentifierType" use="required">
      <xs:annotation><xs:documentation>Nom d'une entité déclarée dans Entities.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="UnitType">
    <xs:annotation>
      <xs:documentation>Unité : groupe d'entités (référencées par leur nom), pouvant contenir des sous-unités.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="EntityRef" type="x:EntityRefType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Unit" type="x:UnitType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Tasks" type="x:TasksType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="x:IdentifierType" use="required"/>
  </xs:complexType>

  <xs:element name="Units" type="x:UnitsType"/>

  <xs:complexType name="UnitsType">
    <xs:sequence>
      <xs:element name="Unit" type="x:UnitType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="x:FileRootAttributes"/>
  </xs:complexType>

</xs:schema>
