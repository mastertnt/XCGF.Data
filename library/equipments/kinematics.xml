<?xml version="1.0" encoding="UTF-8"?>
<!--
  XCGF standard library: kinematic definitions.
  Fixed-wing data follow the aircraft performance data of Command: Modern Operations (CMO),
  so that a CMO importer maps them one to one (see docs/cmo-mapping.md).
-->
<EquipmentLibrary xmlns="urn:xcgf:data:1.0">

  <!-- Root kinematic: every kinematic derives from it and inherits Position and Orientation. -->
  <KinematicDefinition name="Kinematic">
    <Description>Base kinematic: position and orientation.</Description>
    <InitializationData>
      <Parameter name="Position" dataType="GeoPosition"/>
      <Parameter name="Orientation" dataType="Orientation"/>
    </InitializationData>
  </KinematicDefinition>

  <KinematicDefinition name="FixedWingKinematic" base="Kinematic">
    <Description>Fixed-wing aircraft kinematic. Speeds and fuel consumption come from a performance table
      (altitude band x throttle setting), as in CMO; the other data bound or complete it.</Description>
    <TechnologicalData>
      <!-- Masses -->
      <Parameter name="EmptyMass" dataType="MassKilograms">
        <Constraints><Min value="0" inclusive="false"/></Constraints>
      </Parameter>
      <Parameter name="MaxTakeoffMass" dataType="MassKilograms">
        <Constraints><Min ref="EmptyMass"/></Constraints>
      </Parameter>
      <!-- Propulsion -->
      <Parameter name="EngineType" dataType="EngineTypeEnum"><DefaultValue>Turbofan</DefaultValue></Parameter>
      <Parameter name="EngineCount" dataType="Count">
        <DefaultValue>1</DefaultValue>
        <Constraints><Min value="1"/></Constraints>
      </Parameter>
      <Parameter name="DryThrust" dataType="ForceNewtons">
        <Constraints><Min value="0"/></Constraints>
      </Parameter>
      <Parameter name="AfterburnerThrust" dataType="ForceNewtons">
        <Constraints><Min ref="DryThrust"/></Constraints>
      </Parameter>
      <!-- Fuel -->
      <Parameter name="FuelType" dataType="FuelTypeEnum"><DefaultValue>AviationFuel</DefaultValue></Parameter>
      <Parameter name="FuelCapacity" dataType="MassKilograms">
        <Constraints><Min value="0"/></Constraints>
      </Parameter>
      <!-- Performance -->
      <Parameter name="PerformanceTable" dataType="PerformanceTable"/>
      <Parameter name="StallSpeed" dataType="SpeedMetersPerSecond">
        <Constraints><Min value="0" inclusive="false"/></Constraints>
      </Parameter>
      <Parameter name="MaxSpeed" dataType="SpeedMetersPerSecond">
        <Constraints><Min ref="StallSpeed"/></Constraints>
      </Parameter>
      <Parameter name="ClimbRate" dataType="SpeedMetersPerSecond">
        <Constraints><Min value="0" inclusive="false"/></Constraints>
      </Parameter>
      <Parameter name="Ceiling" dataType="DistanceMeters">
        <Constraints><Min value="0" inclusive="false"/></Constraints>
      </Parameter>
      <Parameter name="Agility" dataType="Rating">
        <DefaultValue>3</DefaultValue>
        <Constraints><Min value="0"/></Constraints>
      </Parameter>
      <Parameter name="MinRunwayLength" dataType="DistanceMeters">
        <Constraints><Min value="0"/></Constraints>
      </Parameter>
    </TechnologicalData>
    <InitializationData>
      <!-- Initial state bounded by technological data. -->
      <Parameter name="InitialSpeed" dataType="SpeedMetersPerSecond">
        <Constraints>
          <Min ref="StallSpeed"/>
          <Max ref="MaxSpeed"/>
        </Constraints>
      </Parameter>
      <Parameter name="InitialThrottle" dataType="ThrottleEnum"><DefaultValue>Cruise</DefaultValue></Parameter>
      <Parameter name="InitialFuel" dataType="MassKilograms">
        <Constraints>
          <Min value="0"/>
          <Max ref="FuelCapacity"/>
        </Constraints>
      </Parameter>
    </InitializationData>
  </KinematicDefinition>

</EquipmentLibrary>
