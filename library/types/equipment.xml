<?xml version="1.0" encoding="UTF-8"?>
<DataTypes xmlns="urn:xcgf:data:1.0">
  <Description>XCGF standard library: data types of the standard equipment definitions (fixed-wing kinematic, signatures, sensors). Values are in SI units; the CMO importer converts from CMO units (knots, feet, nautical miles, kg/min...), see docs/cmo-mapping.md.</Description>

  <SimpleData name="MassKilograms" representation="HLAfloat64BE" units="kg" resolution="0.1" accuracy="1">
    <Semantics>Mass in kilograms (aircraft weights, fuel quantities).</Semantics>
  </SimpleData>
  <SimpleData name="MassFlowKilogramsPerSecond" representation="HLAfloat64BE" units="kg/s" resolution="0.001" accuracy="0.001">
    <Semantics>Mass flow in kilograms per second (fuel consumption).</Semantics>
  </SimpleData>
  <SimpleData name="ForceNewtons" representation="HLAfloat64BE" units="N" resolution="1" accuracy="1">
    <Semantics>Force in newtons (engine thrust).</Semantics>
  </SimpleData>
  <SimpleData name="AreaSquareMeters" representation="HLAfloat64BE" units="m2" resolution="0.0001" accuracy="0.0001">
    <Semantics>Area in square metres, notably radar cross section (1 m2 = 0 dBsm).</Semantics>
  </SimpleData>
  <SimpleData name="PowerWatts" representation="HLAfloat64BE" units="W" resolution="1" accuracy="1">
    <Semantics>Power in watts (radar peak power).</Semantics>
  </SimpleData>
  <SimpleData name="FrequencyHertz" representation="HLAfloat64BE" units="Hz" resolution="1" accuracy="1">
    <Semantics>Frequency in hertz (pulse repetition frequency, emission frequency).</Semantics>
  </SimpleData>
  <SimpleData name="Decibels" representation="HLAfloat64BE" units="dB" resolution="0.1" accuracy="0.1">
    <Semantics>Ratio in decibels (antenna gain, noise level, processing gain).</Semantics>
  </SimpleData>
  <SimpleData name="PowerDecibelMilliwatts" representation="HLAfloat64BE" units="dBm" resolution="0.1" accuracy="0.1">
    <Semantics>Power in decibels relative to one milliwatt (receiver sensitivity).</Semantics>
  </SimpleData>
  <SimpleData name="ShortDurationSeconds" representation="HLAfloat64BE" units="s" resolution="0.000000001" accuracy="0.000000001">
    <Semantics>Short duration in seconds with nanosecond resolution, such as a radar pulse width.</Semantics>
  </SimpleData>
  <SimpleData name="Rating" representation="HLAfloat64BE" units="NA" resolution="0.1" accuracy="0.1">
    <Semantics>Dimensionless rating on a tool-defined scale (e.g. CMO agility).</Semantics>
  </SimpleData>
  <SimpleData name="Ratio" representation="HLAfloat64BE" units="NA" resolution="0.001" accuracy="0.001">
    <Semantics>Dimensionless ratio, 1 meaning 100 %.</Semantics>
  </SimpleData>

  <EnumeratedData name="ThrottleEnum" representation="HLAinteger32BE">
    <Semantics>Throttle settings of a performance table, named as in CMO.</Semantics>
    <Enumerator name="Loiter" value="0"><Semantics>Lowest fuel consumption per hour, to stay on station as long as possible.</Semantics></Enumerator>
    <Enumerator name="Cruise" value="1"><Semantics>Best range: lowest fuel consumption per distance flown.</Semantics></Enumerator>
    <Enumerator name="Full" value="2"><Semantics>Maximum dry (military) power.</Semantics></Enumerator>
    <Enumerator name="Flank" value="3"><Semantics>Maximum power with afterburner or emergency power.</Semantics></Enumerator>
  </EnumeratedData>

  <EnumeratedData name="EngineTypeEnum" representation="HLAinteger32BE">
    <Semantics>Kind of engine propelling an aircraft.</Semantics>
    <Enumerator name="Piston" value="0"><Semantics>Piston engine driving a propeller.</Semantics></Enumerator>
    <Enumerator name="Turboprop" value="1"><Semantics>Gas turbine driving a propeller.</Semantics></Enumerator>
    <Enumerator name="Turbojet" value="2"><Semantics>Pure jet engine.</Semantics></Enumerator>
    <Enumerator name="Turbofan" value="3"><Semantics>Bypass jet engine.</Semantics></Enumerator>
    <Enumerator name="Electric" value="4"><Semantics>Electric motor (drones).</Semantics></Enumerator>
    <Enumerator name="Rocket" value="5"><Semantics>Rocket motor.</Semantics></Enumerator>
  </EnumeratedData>

  <EnumeratedData name="FuelTypeEnum" representation="HLAinteger32BE">
    <Semantics>Kind of fuel or energy store.</Semantics>
    <Enumerator name="AviationFuel" value="0"><Semantics>Jet fuel (kerosene).</Semantics></Enumerator>
    <Enumerator name="Gasoline" value="1"><Semantics>Aviation gasoline for piston engines.</Semantics></Enumerator>
    <Enumerator name="Diesel" value="2"><Semantics>Diesel fuel.</Semantics></Enumerator>
    <Enumerator name="Battery" value="3"><Semantics>Electric battery.</Semantics></Enumerator>
  </EnumeratedData>

  <FixedRecordData name="PerformancePoint">
    <Semantics>One row of a performance table: speed and fuel consumption reached in an altitude band at a throttle setting.</Semantics>
    <Field name="MinAltitude" dataType="DistanceMeters"><Semantics>Lower limit of the altitude band.</Semantics></Field>
    <Field name="MaxAltitude" dataType="DistanceMeters"><Semantics>Upper limit of the altitude band.</Semantics></Field>
    <Field name="Throttle" dataType="ThrottleEnum"><Semantics>Throttle setting of the row.</Semantics></Field>
    <Field name="Speed" dataType="SpeedMetersPerSecond"><Semantics>Speed reached in the band at this setting.</Semantics></Field>
    <Field name="FuelConsumption" dataType="MassFlowKilogramsPerSecond"><Semantics>Fuel burnt in the band at this setting.</Semantics></Field>
  </FixedRecordData>

  <ArrayData name="PerformanceTable" dataType="PerformancePoint" cardinality="1..64" encoding="HLAvariableArray">
    <Semantics>Performance table of an aircraft: one point per altitude band and throttle setting.</Semantics>
  </ArrayData>

  <FixedRecordData name="AspectDetectionRange">
    <Semantics>Range at which a reference sensor detects the platform, seen from each aspect (CMO visual and infrared signatures).</Semantics>
    <Field name="Front" dataType="DistanceMeters"><Semantics>Seen from the front.</Semantics></Field>
    <Field name="Side" dataType="DistanceMeters"><Semantics>Seen from either side.</Semantics></Field>
    <Field name="Rear" dataType="DistanceMeters"><Semantics>Seen from the rear.</Semantics></Field>
    <Field name="Top" dataType="DistanceMeters"><Semantics>Seen from above or below.</Semantics></Field>
  </FixedRecordData>

  <FixedRecordData name="AspectRadarCrossSection">
    <Semantics>Radar cross section of the platform seen from each aspect.</Semantics>
    <Field name="Front" dataType="AreaSquareMeters"><Semantics>Seen from the front.</Semantics></Field>
    <Field name="Side" dataType="AreaSquareMeters"><Semantics>Seen from either side.</Semantics></Field>
    <Field name="Rear" dataType="AreaSquareMeters"><Semantics>Seen from the rear.</Semantics></Field>
    <Field name="Top" dataType="AreaSquareMeters"><Semantics>Seen from above or below.</Semantics></Field>
  </FixedRecordData>

  <FixedRecordData name="Dimensions">
    <Semantics>Overall dimensions of a platform.</Semantics>
    <Field name="Length" dataType="DistanceMeters"><Semantics>Length, nose to tail.</Semantics></Field>
    <Field name="Span" dataType="DistanceMeters"><Semantics>Width, wingtip to wingtip (beam for a ship).</Semantics></Field>
    <Field name="Height" dataType="DistanceMeters"><Semantics>Height.</Semantics></Field>
  </FixedRecordData>

  <EnumeratedData name="SensorGenerationEnum" representation="HLAinteger32BE">
    <Semantics>Technology generation of a sensor, used by CMO to scale detection performance (notably infrared and visual).</Semantics>
    <Enumerator name="Early1950s" value="0"><Semantics>Early 1950s.</Semantics></Enumerator>
    <Enumerator name="Late1950s" value="1"><Semantics>Late 1950s.</Semantics></Enumerator>
    <Enumerator name="Early1960s" value="2"><Semantics>Early 1960s.</Semantics></Enumerator>
    <Enumerator name="Late1960s" value="3"><Semantics>Late 1960s.</Semantics></Enumerator>
    <Enumerator name="Early1970s" value="4"><Semantics>Early 1970s.</Semantics></Enumerator>
    <Enumerator name="Late1970s" value="5"><Semantics>Late 1970s.</Semantics></Enumerator>
    <Enumerator name="Early1980s" value="6"><Semantics>Early 1980s.</Semantics></Enumerator>
    <Enumerator name="Late1980s" value="7"><Semantics>Late 1980s.</Semantics></Enumerator>
    <Enumerator name="Early1990s" value="8"><Semantics>Early 1990s.</Semantics></Enumerator>
    <Enumerator name="Late1990s" value="9"><Semantics>Late 1990s.</Semantics></Enumerator>
    <Enumerator name="Early2000s" value="10"><Semantics>Early 2000s.</Semantics></Enumerator>
    <Enumerator name="Late2000s" value="11"><Semantics>Late 2000s.</Semantics></Enumerator>
    <Enumerator name="Early2010s" value="12"><Semantics>Early 2010s.</Semantics></Enumerator>
    <Enumerator name="Late2010s" value="13"><Semantics>Late 2010s.</Semantics></Enumerator>
    <Enumerator name="Early2020s" value="14"><Semantics>Early 2020s.</Semantics></Enumerator>
  </EnumeratedData>

  <EnumeratedData name="SensorRoleEnum" representation="HLAinteger32BE">
    <Semantics>Main role of a sensor.</Semantics>
    <Enumerator name="Other" value="0"><Semantics>Any role not listed here.</Semantics></Enumerator>
    <Enumerator name="AirSearch" value="1"><Semantics>Search for air targets.</Semantics></Enumerator>
    <Enumerator name="SurfaceSearch" value="2"><Semantics>Search for surface targets.</Semantics></Enumerator>
    <Enumerator name="AirAndSurfaceSearch" value="3"><Semantics>Search for air and surface targets.</Semantics></Enumerator>
    <Enumerator name="FireControl" value="4"><Semantics>Track and illuminate targets to guide weapons.</Semantics></Enumerator>
    <Enumerator name="Navigation" value="5"><Semantics>Navigation.</Semantics></Enumerator>
    <Enumerator name="TerrainFollowing" value="6"><Semantics>Terrain following or avoidance.</Semantics></Enumerator>
    <Enumerator name="GroundMapping" value="7"><Semantics>Ground mapping.</Semantics></Enumerator>
    <Enumerator name="Weather" value="8"><Semantics>Weather detection.</Semantics></Enumerator>
    <Enumerator name="RadarWarningReceiver" value="9"><Semantics>Warns that the platform is illuminated by a radar.</Semantics></Enumerator>
    <Enumerator name="ElectronicSupport" value="10"><Semantics>Intercepts and identifies emitters.</Semantics></Enumerator>
    <Enumerator name="InfraredSearchAndTrack" value="11"><Semantics>Passive infrared search and track.</Semantics></Enumerator>
    <Enumerator name="TargetingPod" value="12"><Semantics>Electro-optical or infrared targeting.</Semantics></Enumerator>
    <Enumerator name="MissileApproachWarning" value="13"><Semantics>Detects incoming missiles.</Semantics></Enumerator>
  </EnumeratedData>

  <EnumeratedData name="SensorCapabilityEnum" representation="HLAinteger32BE">
    <Semantics>What a sensor can detect and what it reports about a contact (CMO sensor capabilities).</Semantics>
    <Enumerator name="AirSearch" value="0"><Semantics>Detects air targets.</Semantics></Enumerator>
    <Enumerator name="SurfaceSearch" value="1"><Semantics>Detects surface targets.</Semantics></Enumerator>
    <Enumerator name="LandSearch" value="2"><Semantics>Detects land targets.</Semantics></Enumerator>
    <Enumerator name="PeriscopeSearch" value="3"><Semantics>Detects periscopes and masts.</Semantics></Enumerator>
    <Enumerator name="RangeInformation" value="4"><Semantics>Reports the range of a contact.</Semantics></Enumerator>
    <Enumerator name="HeadingInformation" value="5"><Semantics>Reports the heading of a contact.</Semantics></Enumerator>
    <Enumerator name="SpeedInformation" value="6"><Semantics>Reports the speed of a contact.</Semantics></Enumerator>
    <Enumerator name="AltitudeInformation" value="7"><Semantics>Reports the altitude of a contact.</Semantics></Enumerator>
    <Enumerator name="Classification" value="8"><Semantics>Classifies a contact (kind of platform).</Semantics></Enumerator>
    <Enumerator name="Identification" value="9"><Semantics>Identifies a contact (exact type).</Semantics></Enumerator>
    <Enumerator name="TargetIllumination" value="10"><Semantics>Illuminates a target for weapon guidance.</Semantics></Enumerator>
  </EnumeratedData>

  <ArrayData name="SensorCapabilities" dataType="SensorCapabilityEnum" cardinality="Dynamic" encoding="HLAvariableArray">
    <Semantics>Set of capabilities of a sensor.</Semantics>
  </ArrayData>

  <EnumeratedData name="NatoBandEnum" representation="HLAinteger32BE">
    <Semantics>NATO frequency bands, as used by CMO for emitters and receivers.</Semantics>
    <Enumerator name="A" value="0"><Semantics>0 to 250 MHz.</Semantics></Enumerator>
    <Enumerator name="B" value="1"><Semantics>250 to 500 MHz.</Semantics></Enumerator>
    <Enumerator name="C" value="2"><Semantics>500 MHz to 1 GHz.</Semantics></Enumerator>
    <Enumerator name="D" value="3"><Semantics>1 to 2 GHz.</Semantics></Enumerator>
    <Enumerator name="E" value="4"><Semantics>2 to 3 GHz.</Semantics></Enumerator>
    <Enumerator name="F" value="5"><Semantics>3 to 4 GHz.</Semantics></Enumerator>
    <Enumerator name="G" value="6"><Semantics>4 to 6 GHz.</Semantics></Enumerator>
    <Enumerator name="H" value="7"><Semantics>6 to 8 GHz.</Semantics></Enumerator>
    <Enumerator name="I" value="8"><Semantics>8 to 10 GHz.</Semantics></Enumerator>
    <Enumerator name="J" value="9"><Semantics>10 to 20 GHz.</Semantics></Enumerator>
    <Enumerator name="K" value="10"><Semantics>20 to 40 GHz.</Semantics></Enumerator>
    <Enumerator name="L" value="11"><Semantics>40 to 60 GHz.</Semantics></Enumerator>
    <Enumerator name="M" value="12"><Semantics>60 to 100 GHz.</Semantics></Enumerator>
  </EnumeratedData>

  <ArrayData name="NatoBands" dataType="NatoBandEnum" cardinality="1..13" encoding="HLAvariableArray">
    <Semantics>Set of NATO frequency bands.</Semantics>
  </ArrayData>

  <EnumeratedData name="InfraredBandEnum" representation="HLAinteger32BE">
    <Semantics>Infrared band of a sensor.</Semantics>
    <Enumerator name="NearInfrared" value="0"><Semantics>Near infrared, 0.75 to 1.4 µm.</Semantics></Enumerator>
    <Enumerator name="ShortWave" value="1"><Semantics>Short-wave infrared, 1.4 to 3 µm.</Semantics></Enumerator>
    <Enumerator name="MidWave" value="2"><Semantics>Mid-wave infrared, 3 to 5 µm.</Semantics></Enumerator>
    <Enumerator name="LongWave" value="3"><Semantics>Long-wave infrared, 8 to 14 µm.</Semantics></Enumerator>
    <Enumerator name="DualBand" value="4"><Semantics>Mid-wave and long-wave together.</Semantics></Enumerator>
  </EnumeratedData>

  <EnumeratedData name="RadarFeatureEnum" representation="HLAinteger32BE">
    <Semantics>Radar processing features (CMO sensor codes).</Semantics>
    <Enumerator name="PulseDoppler" value="0"><Semantics>Pulse-Doppler processing.</Semantics></Enumerator>
    <Enumerator name="LookDownShootDown" value="1"><Semantics>Detects low targets against ground clutter.</Semantics></Enumerator>
    <Enumerator name="TrackWhileScan" value="2"><Semantics>Tracks contacts while keeping on searching.</Semantics></Enumerator>
    <Enumerator name="MovingTargetIndicator" value="3"><Semantics>Filters out stationary echoes.</Semantics></Enumerator>
    <Enumerator name="SyntheticAperture" value="4"><Semantics>Synthetic aperture radar imaging (SAR).</Semantics></Enumerator>
    <Enumerator name="InverseSyntheticAperture" value="5"><Semantics>Inverse synthetic aperture imaging of moving targets (ISAR).</Semantics></Enumerator>
    <Enumerator name="ActiveElectronicallyScanned" value="6"><Semantics>Active electronically scanned array (AESA).</Semantics></Enumerator>
    <Enumerator name="PassiveElectronicallyScanned" value="7"><Semantics>Passive electronically scanned array (PESA).</Semantics></Enumerator>
    <Enumerator name="FrequencyAgility" value="8"><Semantics>Changes frequency to resist jamming.</Semantics></Enumerator>
    <Enumerator name="LowProbabilityOfIntercept" value="9"><Semantics>Waveforms hard to intercept (LPI).</Semantics></Enumerator>
    <Enumerator name="NonCooperativeTargetRecognition" value="10"><Semantics>Identifies targets from their echo (NCTR).</Semantics></Enumerator>
  </EnumeratedData>

  <ArrayData name="RadarFeatures" dataType="RadarFeatureEnum" cardinality="Dynamic" encoding="HLAvariableArray">
    <Semantics>Set of processing features of a radar.</Semantics>
  </ArrayData>

  <FixedRecordData name="SensorArc">
    <Semantics>Angular sector covered by a sensor, relative to the platform heading and horizontal plane. The azimuth sector goes clockwise from AzimuthStart to AzimuthEnd.</Semantics>
    <Field name="AzimuthStart" dataType="AngleDegrees"><Semantics>Start of the sector, clockwise from the nose, in [0, 360).</Semantics></Field>
    <Field name="AzimuthEnd" dataType="AngleDegrees"><Semantics>End of the sector, clockwise from the nose, in [0, 360).</Semantics></Field>
    <Field name="ElevationMin" dataType="AngleDegrees"><Semantics>Lowest elevation covered, in [-90, 90].</Semantics></Field>
    <Field name="ElevationMax" dataType="AngleDegrees"><Semantics>Highest elevation covered, in [-90, 90].</Semantics></Field>
  </FixedRecordData>

  <ArrayData name="SensorArcs" dataType="SensorArc" cardinality="Dynamic" encoding="HLAvariableArray">
    <Semantics>Sectors covered by a sensor.</Semantics>
  </ArrayData>

</DataTypes>
